# --- Secrets. Never commit these. ---------------------------------------
# .env holds the real OPENAI_API_KEY and ANTHROPIC_API_KEY.
# .env.example is the committed template and holds placeholders only.
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
credentials.json
secrets.json
.netrc

