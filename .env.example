# Copy this file to .env and fill in your own values:
#
#   cp .env.example .env
#
# .env is gitignored and must never be committed. This file is the committed
# template and must only ever contain the placeholders below.

# --- Required: Claude, for understanding the question and proposing options --
# Get a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=replace-with-your-anthropic-key

# Only needed if the key above is an organisation-level key rather than one
# created inside a workspace. Such a key must name a workspace or the API
# returns a 400. Leave this commented out for a workspace-scoped key.
# ANTHROPIC_WORKSPACE_ID=replace-with-your-workspace-id

# --- Required: embeddings, for retrieving the policy documents ---------------
# Get a key: https://platform.openai.com/api-keys
# Indexing the five synthetic policy documents costs a fraction of a cent.
OPENAI_API_KEY=replace-with-your-openai-key

# --- Local database created by docker-compose.yml ---------------------------
# Not a secret: this container is built by this repository, is bound to the
# loopback interface, and holds synthetic data only.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/supply_chain

# --- Models -----------------------------------------------------------------
CLAUDE_MODEL=claude-opus-5-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
